# Orchestrator base URL, for example https://orient-orchestrator-xxxx-ew.a.run.app
# Leave unset to run against the in-browser mock orchestrator.
VITE_API_BASE_URL=

# "true" adds a cog with camera feed, logs, motion data and payload inspection (with a frame pause).
VITE_DEBUG_MODE=

# "true" turns microphone voice isolation on by default (noise gate, no auto gain). The debug panel overrides it per device.
VITE_VOICE_ISOLATION=

# nav-engine map-api for /map (recording walks of a place). Leave unset for the team's Cloud Run service.
# For a local map-api: http://127.0.0.1:8450 (its NAV_CORS_ORIGIN_REGEX must allow this origin).
VITE_MAP_API_URL=
