{
  // Static assets only: no Worker script. The orchestrator runs on Google Cloud.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orient-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
  // Custom domain (add once the domain is chosen):
  // "routes": [{ "pattern": "orient.example.com", "custom_domain": true }]
}
